        "subject": "Your Dubai Property Guide & Curated Portfolio",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Dubai Property Follow-up</title>\n</head>\n\n<body style=\"margin:0; padding:0; background-color:#f3f5f7; font-family:Arial, Helvetica, sans-serif; color:#1f2937;\">\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n       style=\"background-color:#f3f5f7; padding:30px 10px;\">\n\n<tr>\n<td align=\"center\">\n\n<table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n       style=\"max-width:600px; width:100%; background:#ffffff; border-radius:16px; overflow:hidden;\">\n\n<!-- HEADER -->\n<tr>\n<td style=\"background:#111827; padding:30px 35px; text-align:center;\">\n\n<div style=\"font-size:13px; letter-spacing:2px; color:#d4af37; font-weight:bold;\">\nDUBAI LUXURY REAL ESTATE\n</div>\n\n<div style=\"font-size:26px; color:#ffffff; font-weight:bold; margin-top:8px;\">\nLet's Find Your Property\n</div>\n\n<div style=\"font-size:14px; color:#d1d5db; margin-top:8px;\">\nPersonalized property recommendations\n</div>\n\n</td>\n</tr>\n\n\n<!-- GREETING -->\n<tr>\n<td style=\"padding:32px 35px 20px 35px;\">\n\n<div style=\"font-size:22px; font-weight:bold; color:#111827; margin-bottom:12px;\">\nDear {{ $json['Name'] }},\n</div>\n\n<div style=\"font-size:15px; line-height:1.7; color:#4b5563;\">\n\nThank you for sharing your property requirements with us.\n\nBased on your preferences, we believe there may be several\nproperties in <strong style=\"color:#111827;\">\n{{ $json['Preferred Location'] }}\n</strong>\nthat could match what you're looking for.\n\n</div>\n\n</td>\n</tr>\n\n\n<!-- STATUS -->\n<tr>\n<td style=\"padding:10px 35px 25px 35px;\">\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\nstyle=\"background:#fff8e1; border:1px solid #f1d77a; border-radius:12px;\">\n\n<tr>\n<td style=\"padding:18px 20px;\">\n\n<table width=\"100%\">\n<tr>\n\n<td style=\"font-size:14px; color:#6b7280;\">\nLead Status\n</td>\n\n<td align=\"right\">\n\n<span style=\"\ndisplay:inline-block;\nbackground:#fef3c7;\ncolor:#92400e;\npadding:7px 14px;\nborder-radius:20px;\nfont-size:13px;\nfont-weight:bold;\">\n{{ $json['Category'] }}\n</span>\n\n</td>\n\n</tr>\n</table>\n\n<div style=\"margin-top:15px;\">\n\n<span style=\"font-size:32px; font-weight:bold; color:#111827;\">\n{{ $json['AI Score'] }}\n</span>\n\n<span style=\"font-size:14px; color:#6b7280;\">\n/ 100 Lead Score\n</span>\n\n</div>\n\n</td>\n</tr>\n\n</table>\n\n</td>\n</tr>\n\n\n<!-- REQUIREMENTS -->\n<tr>\n<td style=\"padding:0 35px 25px 35px;\">\n\n<div style=\"font-size:18px; font-weight:bold; color:#111827; margin-bottom:15px;\">\nYour Property Requirements\n</div>\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"\nborder=\"0\"\nstyle=\"border:1px solid #e5e7eb; border-radius:12px;\">\n\n<tr>\n<td style=\"padding:14px 16px; background:#f9fafb; color:#6b7280; font-size:14px;\">\n📍 Preferred Location\n</td>\n\n<td style=\"padding:14px 16px; font-size:14px; font-weight:bold;\">\n{{ $json['Preferred Location'] }}\n</td>\n</tr>\n\n<tr>\n<td style=\"padding:14px 16px; color:#6b7280; font-size:14px;\">\n🏠 Property Type\n</td>\n\n<td style=\"padding:14px 16px; font-size:14px; font-weight:bold;\">\n{{ $json['Property Type'] }}\n</td>\n</tr>\n\n<tr>\n<td style=\"padding:14px 16px; background:#f9fafb; color:#6b7280; font-size:14px;\">\n💰 Budget\n</td>\n\n<td style=\"padding:14px 16px; font-size:14px; font-weight:bold;\">\nAED {{ $json['Budget'] }}\n</td>\n</tr>\n\n<tr>\n<td style=\"padding:14px 16px; color:#6b7280; font-size:14px;\">\n⏱ Buying Timeline\n</td>\n\n<td style=\"padding:14px 16px; font-size:14px; font-weight:bold;\">\n{{ $json['Timeline'] }}\n</td>\n</tr>\n\n</table>\n\n</td>\n</tr>\n\n\n<!-- FOLLOW UP -->\n<tr>\n<td style=\"padding:0 35px 25px 35px;\">\n\n<div style=\"\nbackground:#f9fafb;\nborder-left:4px solid #d4af37;\npadding:18px;\nborder-radius:8px;\nfont-size:14px;\nline-height:1.7;\ncolor:#4b5563;\">\n\nOur property specialists can help you explore options\nthat match your budget, preferred location, and property type.\n\n<strong style=\"color:#111827;\">\nWould you like us to send you some suitable properties?\n</strong>\n\n</div>\n\n</td>\n</tr>\n\n\n<!-- CTA -->\n<tr>\n<td align=\"center\" style=\"padding:5px 35px 35px 35px;\">\n\n<a href=\"YOUR_PROPERTY_LISTING_OR_BOOKING_LINK\"\nstyle=\"\ndisplay:inline-block;\nbackground:#111827;\ncolor:#ffffff;\ntext-decoration:none;\npadding:14px 30px;\nborder-radius:8px;\nfont-size:14px;\nfont-weight:bold;\">\n\nExplore Suitable Properties →\n\n</a>\n\n</td>\n</tr>\n\n\n<!-- FOOTER -->\n<tr>\n<td style=\"\nbackground:#f9fafb;\npadding:22px 35px;\ntext-align:center;\nborder-top:1px solid #e5e7eb;\">\n\n<div style=\"font-size:13px; color:#6b7280;\">\nDubai Luxury Real Estate\n</div>\n\n<div style=\"font-size:12px; color:#9ca3af; margin-top:6px;\">\nPersonalized property assistance in Dubai\n</div>\n\n</td>\n</tr>\n\n</table>\n\n</td>\n</tr>\n</table>\n\n</body>\n</html>",
