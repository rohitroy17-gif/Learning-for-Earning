        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Dubai Luxury Real Estate</title>\n</head>\n\n<body style=\"margin:0; padding:0; background-color:#f3f5f7; font-family:Arial, Helvetica, sans-serif; color:#1f2937;\">\n\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f3f5f7; padding:30px 10px;\">\n    <tr>\n      <td align=\"center\">\n\n        <!-- Main Container -->\n        <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n          style=\"max-width:600px; width:100%; background:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 5px 20px rgba(0,0,0,0.08);\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background:#111827; padding:30px 35px; text-align:center;\">\n\n              <div style=\"font-size:13px; letter-spacing:2px; color:#d4af37; font-weight:bold; margin-bottom:8px;\">\n                DUBAI LUXURY REAL ESTATE\n              </div>\n\n              <div style=\"font-size:28px; color:#ffffff; font-weight:bold;\">\n                Private Consultation\n              </div>\n\n              <div style=\"font-size:14px; color:#d1d5db; margin-top:8px;\">\n                Your property requirements have been received\n              </div>\n\n            </td>\n          </tr>\n\n          <!-- Greeting -->\n          <tr>\n            <td style=\"padding:32px 35px 20px 35px;\">\n\n              <div style=\"font-size:22px; font-weight:bold; color:#111827; margin-bottom:12px;\">\n                Dear {{ $json['Name'] }},\n              </div>\n\n              <div style=\"font-size:15px; line-height:1.7; color:#4b5563;\">\n                Thank you for inquiring about luxury real estate opportunities\n                in <strong style=\"color:#111827;\">{{ $json['Preferred Location'] }}</strong>.\n                Based on your profile and requirements, our senior advisory team\n                has prioritized your request for a private consultation.\n              </div>\n\n            </td>\n          </tr>\n\n          <!-- Lead Status -->\n          <tr>\n            <td style=\"padding:10px 35px 25px 35px;\">\n\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n                style=\"background:#fff8e1; border:1px solid #f1d77a; border-radius:12px;\">\n\n                <tr>\n                  <td style=\"padding:18px 20px;\">\n\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                      <tr>\n\n                        <td style=\"font-size:14px; color:#6b7280;\">\n                          AI Qualification\n                        </td>\n\n                        <td align=\"right\">\n                          <span style=\"display:inline-block; background:#dcfce7; color:#166534; padding:7px 14px; border-radius:20px; font-size:13px; font-weight:bold;\">\n                            {{ $json['Category'] }}\n                          </span>\n                        </td>\n\n                      </tr>\n                    </table>\n\n                    <div style=\"margin-top:15px;\">\n\n                      <span style=\"font-size:36px; font-weight:bold; color:#111827;\">\n                        {{ $json['AI Score'] }}\n                      </span>\n\n                      <span style=\"font-size:14px; color:#6b7280;\">\n                        / 100 Lead Score\n                      </span>\n\n                    </div>\n\n                  </td>\n                </tr>\n\n              </table>\n\n            </td>\n          </tr>\n\n          <!-- Inquiry Overview -->\n          <tr>\n            <td style=\"padding:0 35px 25px 35px;\">\n\n              <div style=\"font-size:18px; font-weight:bold; color:#111827; margin-bottom:15px;\">\n                Inquiry Overview\n              </div>\n\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n                style=\"border:1px solid #e5e7eb; border-radius:12px; overflow:hidden;\">\n\n                <!-- Location -->\n                <tr>\n                  <td style=\"padding:14px 16px; background:#f9fafb; color:#6b7280; font-size:14px; width:40%;\">\n                    📍 Preferred Location\n                  </td>\n\n                  <td style=\"padding:14px 16px; font-size:14px; font-weight:bold; color:#111827;\">\n                    {{ $json['Preferred Location'] }}\n                  </td>\n                </tr>\n\n                <!-- Property -->\n                <tr>\n                  <td style=\"padding:14px 16px; color:#6b7280; font-size:14px;\">\n                    🏠 Property Type\n                  </td>\n\n                  <td style=\"padding:14px 16px; font-size:14px; font-weight:bold; color:#111827;\">\n                    {{ $json['Property Type'] }}\n                  </td>\n                </tr>\n\n                <!-- Budget -->\n                <tr>\n                  <td style=\"padding:14px 16px; background:#f9fafb; color:#6b7280; font-size:14px;\">\n                    💰 Budget\n                  </td>\n\n                  <td style=\"padding:14px 16px; font-size:14px; font-weight:bold; color:#111827;\">\n                    AED {{ $json['Budget'] }}\n                  </td>\n                </tr>\n\n                <!-- Timeline -->\n                <tr>\n                  <td style=\"padding:14px 16px; color:#6b7280; font-size:14px;\">\n                    ⏱ Buying Timeline\n                  </td>\n\n                  <td style=\"padding:14px 16px; font-size:14px; font-weight:bold; color:#111827;\">\n                    {{ $json['Timeline'] }}\n                  </td>\n                </tr>\n\n              </table>\n\n            </td>\n          </tr>\n\n          <!-- AI Reasoning -->\n          <tr>\n            <td style=\"padding:0 35px 25px 35px;\">\n\n              <div style=\"font-size:18px; font-weight:bold; color:#111827; margin-bottom:12px;\">\n                AI Qualification Analysis\n              </div>\n\n              <div style=\"background:#f9fafb; border-left:4px solid #d4af37; padding:16px 18px; border-radius:8px; font-size:14px; line-height:1.7; color:#4b5563;\">\n\n                {{ $json['AI Reasoning'] }}\n\n              </div>\n\n            </td>\n          </tr>\n\n          <!-- CTA -->\n          <tr>\n            <td align=\"center\" style=\"padding:10px 35px 35px 35px;\">\n\n              <div style=\"font-size:15px; color:#4b5563; margin-bottom:18px;\">\n                Ready to explore suitable properties?\n              </div>\n\n              <a href=\"YOUR_GOOGLE_CALENDAR_BOOKING_LINK\"\n                style=\"display:inline-block; background:#111827; color:#ffffff; text-decoration:none; padding:14px 28px; border-radius:8px; font-size:14px; font-weight:bold;\">\n                Schedule Private Consultation →\n              </a>\n\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"background:#f9fafb; padding:22px 35px; text-align:center; border-top:1px solid #e5e7eb;\">\n\n              <div style=\"font-size:13px; color:#6b7280;\">\n                Dubai Luxury Real Estate\n              </div>\n\n              <div style=\"font-size:12px; color:#9ca3af; margin-top:6px;\">\n                Your trusted partner for premium Dubai properties\n              </div>\n\n            </td>\n          </tr>\n\n        </table>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
